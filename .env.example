# Server Configuration
PORT=8000
HOST=0.0.0.0

# Meta WhatsApp Cloud API Credentials
# Get these from Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WEBHOOK_VERIFY_TOKEN=wauto_verify_token_dev
WHATSAPP_APP_SECRET=

# Google Gemini AI API Key (Optional: project runs with smart heuristic engine if empty)
# Get this from https://aistudio.google.com
GEMINI_API_KEY=

# Google Calendar API Credentials (Optional: project uses simulated meet link if empty)
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# Custom Business Information
BUSINESS_NAME="Apex Solutions"
BUSINESS_HOURS="Mon - Fri: 9:00 AM - 6:00 PM EST"
BUSINESS_SERVICES="AI Automation, Custom Software, WhatsApp Agents, Cloud Systems"
BUSINESS_PRICING="Starter: $500 | Professional: $1,200 | Enterprise: $2,500/mo"
